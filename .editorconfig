root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts}]
ij_kotlin_imports_layout = *
ij_kotlin_line_comment_at_first_column = true

[*.{xml,json,yml,yaml,md}]
indent_size = 2
